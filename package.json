{
  "name": "daifuku",
  "version": "0.1.0",
  "description": "入力の楽さに全振りした家計簿。入出金と資産残高を切り離して記録する",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --var DEVELOPMENT:1 --port 8788",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "dev:remote": "wrangler dev --remote --port 8788",
    "dev:demo": "wrangler dev --config wrangler.demo.jsonc --port 8789",
    "deploy:demo": "wrangler deploy --config wrangler.demo.jsonc",
    "test": "node --test tests/*.test.mjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "og": "node tools/og.mjs",
    "check:privacy": "node tools/privacy-check.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0"
  }
}
